{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "itemize-lol",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "itemize.lol", "custom_domain": true }],
  // the workers.dev address stays up next to the domain, and each uploaded version gets a preview address
  "workers_dev": true,
  "preview_urls": true,
  // the site: served straight from Cloudflare's edge, the Worker only sees what is not a file here
  "assets": { "directory": ".build/site" },
  // packs data/dist into .build/data.txt and prepares web/ in .build/site/
  "build": { "command": "node scripts/bundle.ts && node scripts/site.ts", "watch_dir": ["src", "web", "scripts"] },
  // POST /api/v1/calc, per client address
  "ratelimits": [
    { "name": "CALC_LIMIT", "namespace_id": "1001", "simple": { "limit": 240, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
