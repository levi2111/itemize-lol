# Headers Cloudflare adds to the static site. Keep the policy in step with src/server/app.ts,
# which sets the same one on API responses and on everything the Node server sends.
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Named by their contents (scripts/site.ts, src/pipeline/art.ts) or by their version, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/art/:version/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
